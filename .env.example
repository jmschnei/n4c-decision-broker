# --- Ollama System One model (default: local nimble) ---
# ollama pull nimble   (needs Ollama >= 0.35)
# OLLAMA_HOST=http://localhost:11434
# N4C_BROKER_BASE_URL=http://localhost:11434   # takes precedence over OLLAMA_HOST
# N4C_BROKER_MODEL=nimble
# OLLAMA_API_KEY=        # only for Ollama cloud models (e.g. clef:cloud)

# --- Optional LLM fallback for escalated decisions (OpenAI-compatible) ---
# Tip: use local Ollama too: FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
# FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
# FALLBACK_LLM_API_KEY=ollama
# FALLBACK_LLM_MODEL=llama3.1:8b

# --- REST server auth (required when binding to a non-loopback host) ---
# Comma-separated; send as "Authorization: Bearer <key>" or "X-API-Key: <key>"
# N4C_BROKER_API_KEYS=change-me-1,change-me-2
